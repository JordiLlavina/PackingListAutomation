<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- El parent de Spring Boot gestiona las versiones de casi todas las
         dependencias (Jackson incluido) y la configuración del compilador. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.puntotres</groupId>
    <artifactId>packing-list-ami</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <!-- La PWA de modelos (frontend/) se construye con cada build de
             Maven. -Dskip.frontend=true se la salta para iterar rápido en el
             backend: los tests de Java no dependen de ella. -->
        <skip.frontend>false</skip.frontend>
        <!-- Lo que arranca mvn exec:java: la prueba manual de siempre, salvo
             que se pida otra clase con -Dexec.mainClass (GenerarClavesVapid). -->
        <exec.mainClass>com.puntotres.packinglist.Main</exec.mainClass>
    </properties>

    <!-- Openize.HEIC no está en Maven Central: lo publica Aspose en su repositorio. -->
    <repositories>
        <repository>
            <id>aspose</id>
            <name>Aspose (Openize.HEIC)</name>
            <url>https://releases.aspose.com/java/repo/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Web MVC con servidor embebido: el asistente de generación de
             packing lists (pegar JSON -> revisar -> descargar excels). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Plantillas de las pantallas del asistente. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Validación de formularios (@NotBlank, @Pattern en EnvioForm). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security: usuarios de la app de modelos (contraseñas con
             BCrypt) y, más adelante, la cadena de filtros que la protege. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Lo que el programa tiene que recordar entre ejecuciones: qué cartón
             y cuántas unidades por caja lleva cada referencia, y la tabla de
             taras. H2 en fichero para que sobreviva al reinicio sin instalar
             ni administrar nada. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway crea el esquema (db/migration) y Hibernate solo lo valida:
             una entidad que no cuadra con el SQL rompe el primer arranque en
             vez de dejar una tabla a medias. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Apache POI: lectura/escritura de .xlsx (formato OOXML).
             No la gestiona Boot, por eso lleva versión explícita. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- Barcode4J: generación de códigos de barras Code 128 para las
             etiquetas de caja (imagen PNG con el número legible debajo). -->
        <dependency>
            <groupId>net.sf.barcode4j</groupId>
            <artifactId>barcode4j</artifactId>
            <version>2.1</version>
        </dependency>

        <!-- ZXing: el código QR de la etiqueta de información de embalaje
             (barcode4j no sabe hacer QR). core codifica; javase lo pasa a PNG. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
            <!-- Plugins ImageIO que se registrarían en toda la JVM y no hacen falta. -->
            <exclusions>
                <exclusion>
                    <groupId>com.beust</groupId>
                    <artifactId>jcommander</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.jai-imageio</groupId>
                    <artifactId>jai-imageio-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Documentos del corte: las fotos del iPhone llegan en HEIC y ni
             ImageIO ni POI saben leerlo. Java puro para que funcione igual en
             el PC del almacén y en el servidor Linux; en Windows se prueba
             antes el decodificador del sistema, que es más rápido. -->
        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>openize-heic</artifactId>
            <version>26.5</version>
        </dependency>

        <!-- Orientación EXIF de los JPG: sin ella las fotos de móvil salen tumbadas. -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.20.0</version>
        </dependency>

        <!-- Jackson: parseo del JSON de entrada (versión gestionada por Boot) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- SDK oficial de Anthropic: extracción del packing list a partir
             de imágenes (modo CLAUDE de la pantalla de entrada). -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.49.0</version>
        </dependency>

        <!-- Web Push con VAPID: los avisos al móvil de la app de modelos
             (órdenes nuevas al taller, avisos y respuestas al despacho).
             Se usa su PushService síncrono (Apache HttpAsyncClient): el
             cliente asíncrono de Netty (async-http-client) y la línea de
             órdenes (jcommander) sobran. -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.asynchttpclient</groupId>
                    <artifactId>async-http-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.beust</groupId>
                    <artifactId>jcommander</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- BouncyCastle: web-push lo necesita para cifrar cada mensaje con las
             claves de la suscripción y firmar con VAPID, pero no lo trae (lo
             declara como provided). La versión para Java 18+ (vale en el 17). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Para probar la app de modelos con MockMvc: entrar como un usuario
             concreto (authentication) y mandar el token CSRF (csrf). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Declarar <resources> sustituye entero el bloque del parent de
             Spring Boot, así que sus dos entradas van copiadas tal cual
             (application*.yml con filtrado, el resto sin él). La tercera mete
             el build de la PWA en static/app, de donde la sirve SpaController
             en /app. Si frontend/dist no existe (-Dskip.frontend=true sin
             haber construido nunca la PWA), Maven se la salta sin error. -->
        <resources>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/application*.yml</include>
                    <include>**/application*.yaml</include>
                    <include>**/application*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>${basedir}/src/main/resources</directory>
                <excludes>
                    <exclude>**/application*.yml</exclude>
                    <exclude>**/application*.yaml</exclude>
                    <exclude>**/application*.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${basedir}/frontend/dist</directory>
                <targetPath>static/app</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- La PWA de modelos (React + Vite, en frontend/): sin Node
                 instalado en la máquina. El plugin se baja su propio Node a
                 frontend/node/ la primera vez (no entra en el repo), instala
                 las dependencias exactas del package-lock.json (npm ci),
                 construye en generate-resources, antes de que Maven copie los
                 recursos, y pasa los tests de Vitest con los de Java en la
                 fase test (-DskipTests también se los salta). -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <installDirectory>frontend</installDirectory>
                    <workingDirectory>frontend</workingDirectory>
                    <skip>${skip.frontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>v22.12.0</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-run-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.puntotres.packinglist.PackingListApplication</mainClass>
                </configuration>
            </plugin>
            <!-- Todos los tests corren con el perfil "test", que apunta la
                 base de datos a memoria (src/test/resources/application-test.yml).
                 Va aquí y no como @ActiveProfiles en cada clase a propósito:
                 un @SpringBootTest nuevo al que se le olvidara la anotación
                 escribiría en la base de datos real del almacén sin avisar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Comodidad para la prueba manual clásica: mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
